# Local defaults only; never place secrets in this file.
DATABASE_PATH=/app/data/world.sqlite3
WORLD_RANDOM_EVENT_CHANCE=0.15
HABITAT_HOST=127.0.0.1
HABITAT_PORT=8765
# Optional OpenAI-compatible model endpoint. HTTPS for remote hosts; loopback HTTP allowed.
# HABITAT_AI_BASE_URL=http://127.0.0.1:11434/v1
# HABITAT_AI_MODEL=your-local-model
# DeepSeek direct connection (explicit opt-in only):
# HABITAT_AI_BASE_URL=https://api.deepseek.com
# HABITAT_AI_MODEL=deepseek-flash
# Optional. The local page can write this to ignored .env when you choose "保存到本机配置".
# HABITAT_AI_API_KEY=replace-with-your-key

# Optional Compose QQ bridge. The NapCat service is started with --profile qq.
# Generate unique random values for all tokens before using this on a server.
HABITAT_ONEBOT_URL=http://napcat:5700
HABITAT_ONEBOT_ACCESS_TOKEN=replace-with-onebot-http-server-token
HABITAT_ONEBOT_INBOUND_TOKEN=replace-with-a-different-random-token
HABITAT_ONEBOT_TARGET_USER_ID=replace-with-phone-sender-qq-number
# Leave blank to auto-select the only resident; otherwise use its full current ID.
HABITAT_ONEBOT_RESIDENT_ID=
HABITAT_TRUSTED_INTERNAL_HOSTS=cyber-habitat,napcat
NAPCAT_WEBUI_TOKEN=replace-with-a-third-random-token
# Pin a tested NapCat image tag for deployment; the default is the documented image.
# NAPCAT_IMAGE=mlikiowa/napcat-docker:latest
